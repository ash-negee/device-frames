{
  "name": "react-device-bezels",
  "version": "0.1.0",
  "description": "Pure SCSS React device bezels for iOS and Android phones and tablets.",
  "license": "MIT",
  "author": "ash",
  "homepage": "https://github.com/ash-negee/device-frames#readme",
  "bugs": {
    "url": "https://github.com/ash-negee/device-frames/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ash-negee/device-frames.git"
  },
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "dist/styles.css",
    "src/styles/*.scss"
  ],
  "files": [
    "dist",
    "docs/screenshots",
    "src/styles",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "sass": "./src/styles/device-frames.scss",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": {
      "sass": "./src/styles/device-frames.scss",
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.scss": "./src/styles/device-frames.scss",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsup src/index.ts --format esm,cjs --dts --external react && sass src/styles/device-frames.scss dist/styles.css --style=compressed",
    "check": "npm run typecheck && npm run pack:dry-run",
    "dev": "vite demo --host 0.0.0.0",
    "pack:dry-run": "npm pack --dry-run --cache /tmp/react-device-bezels-npm-cache",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.89.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.2.7"
  },
  "keywords": [
    "android",
    "css",
    "device",
    "device-bezel",
    "device-frame",
    "frames",
    "ios",
    "iphone",
    "ipad",
    "mobile",
    "mockup",
    "react",
    "scss",
    "screenshot",
    "tablet"
  ]
}
